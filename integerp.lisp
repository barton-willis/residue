(defun integerp-literal (e) (integerp e))

(defun integerp-declared (e) (kindp e '$integer))

(defun integerp-symbolic (e)
    (cond (($mapatom e) (or (integerp-literal e) (integerp-declared e)))
          ((or (mtimesp e) (mplusp e)) (every #'integerp-symbolic (cdr e)))
          ((and (mexptp e) (and (integerp-symbolic (second e)) 
                                (integerp-symbolic (third e))
                                (eq t (mgqp (third e) 0)))))
          ((and (get (caar e) 'maps-integers-to-integers) 
                (every #'integerp-symbolic (cdr e))))
          ((get (caar e) 'integer-valued))
          (t nil)))

(defmfun $integerp (e &rest integer-types)
  (flet ((fn (x)
           (cond ((eq x '$literal)  #'integerp-literal)
                 ((eq x '$declared) #'integerp-declared)
                 ((eq x '$symbolic) #'integerp-symbolic)
                 (t (merror "integerp: unknown option ~M" x)))))
    (if (null integer-types)
        (integerp-literal e) 
        (some (lambda (selector) (funcall (fn selector) e)) integer-types))))